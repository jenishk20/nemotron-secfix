# Copy to .env and fill in. .env is gitignored; never commit real keys.
WANDB_API_KEY=            # W&B Inference, Serverless Training, Sandboxes
WANDB_ENTITY=             # your W&B entity (team or username)
WANDB_PROJECT=nemotron-secfix
FIREWORKS_API_KEY=        # Fireworks (SFT, deployments, serverless baselines)
FW_ACCOUNT=               # your Fireworks account id (accounts/<this>)
FW_BUCKET=                # private GCS bucket Fireworks can read (dataset import, see README)
GCP_PROJECT=              # Vertex AI (Gemini baselines)
GCP_LOCATION=global
GOOGLE_ADC_B64=           # base64 of a Google ADC credentials JSON (Gemini baselines)
OPENROUTER_API_KEY=       # optional: OpenRouter baselines
HF_TOKEN=                 # optional: Hugging Face uploads
